# copy to .env for local dev. never commit .env.

# database (docker-compose `db` service)
DATABASE_URL=postgres://passport:passport@localhost:5433/passport

# pdf rendering (docker-compose `gotenberg` service)
GOTENBERG_URL=http://localhost:3100

# google sheets: the sheet id from its url, and the service account key file
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json

# solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# issuer signing key (daily key). the authority key stays offline, not in env
ISSUER_KEY_FILE=./secrets/issuer.json

# web login (google oauth) and admins
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
PUBLIC_BASE_URL=http://localhost:3000
